  "seo_description": "Learn professional emails, meeting minutes, status reports and AI-assisted workplace writing in 4 weeks (32h). Build a practical toolkit. Fee ₹4,900.",
  "overview": {
    "heading": "What You Will Master",
    "description": "Learn effective workplace communication through professional email writing, business messages, meeting participation, reports, stakeholder updates and appropriate use of AI writing assistance. Develop clear, concise and accurate communication skills for modern office and business environments.",
    "expanded_copy": "Develop practical written and verbal communication skills for everyday office work. Learn to write clear business emails, structure requests and responses, participate effectively in meetings and document decisions and responsibilities. Practise writing status reports, reporting delays, handling constructive disagreement and communicating professionally across teams. Use modern collaboration tools and AI writing assistance responsibly while checking accuracy and protecting confidential information.",
    "commercial_differentiation": "Learn to Communicate Work Clearly — Not Just Write Grammatically Correct Sentences.",
    "professional_workflow": "Understand Purpose → Identify Audience → Choose Channel → Draft → Verify → Communicate → Record Decisions → Follow Up",
    "core_principles": [
      "Purposeful: every message has a clear, understandable objective",
      "Relevant: addresses specific reader information needs without fluff",
      "Clear: simple, unambiguous plain-English phrasing",
      "Concise: respects recipient time with focused paragraphs",
      "Accurate: verified names, dates, figures, and commitments",
      "Respectful: calm, empathetic, and professional tone",
      "Actionable: visible expectations, owners, and next steps",
      "Channel-Appropriate: choosing email, chat, document, or meeting deliberately",
      "Confidential: protecting sensitive company and client data"
    ]
  },
  "why_now": null,
  "learning_journey": null,
