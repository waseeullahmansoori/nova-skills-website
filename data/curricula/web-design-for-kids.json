  "faq": [
    {
      "question": "What is Web Design for Kids — HTML & CSS Foundations?",
      "answer": "It is a beginner course where children learn to create and style webpages using HTML and CSS."
    },
    {
      "question": "What age group is recommended?",
      "answer": "The course is recommended for ages 10–16."
    },
    {
      "question": "How long is the course?",
      "answer": "Six weeks with 32 learning hours."
    },
    {
      "question": "What is the course fee?",
      "answer": "₹4,900, subject to verified Nova Skills pricing and tax policy."
    },
    {
      "question": "Is coding experience required?",
      "answer": "No. The course starts with website and HTML fundamentals."
    },
    {
      "question": "What is HTML?",
      "answer": "HTML defines the structure and meaning of a webpage's content."
    },
    {
      "question": "What is CSS?",
      "answer": "CSS controls the visual appearance and layout of webpages."
    },
    {
      "question": "Will my child build a real website?",
      "answer": "Yes. Students create a working multipage HTML/CSS website."
    },
    {
      "question": "Will the website work on mobile screens?",
      "answer": "Students learn foundational responsive design and test their site at different screen sizes."
    },
    {
      "question": "What pages will the project include?",
      "answer": "A homepage, hobby/project page and an original gallery or information section."
    },
    {
      "question": "Will students learn navigation?",
      "answer": "Yes. They will create working links between pages."
    },
    {
      "question": "Will students learn Flexbox?",
      "answer": "Yes. Flexbox is introduced for beginner layouts and responsive content."
    },
    {
      "question": "Will students learn basic design principles?",
      "answer": "Yes. The course covers typography, colour, spacing, alignment and visual hierarchy."
    },
    {
